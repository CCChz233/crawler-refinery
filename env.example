# ============================================
# 环境变量配置文件（仅包含敏感信息）
# ============================================
# 使用方法：
# 1. 复制此文件为 .env
# 2. 填入实际的API密钥
# 3. 确保 .env 文件已添加到 .gitignore
# 
# 注意：业务配置请修改 config.yaml 文件

# ============================================
# Supabase 配置
# ============================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your_service_role_key_here"

# ============================================
# 火山引擎 API 配置（用于大模型调用）
# ============================================
# 火山引擎 API Token（用于 deepseek-v3-1-terminus）
VOLCANO_API_TOKEN="your_volcano_api_token_here"
# 火山引擎 API 端点（默认北京区域，可在 config.yaml 中覆盖）
VOLCANO_API_ENDPOINT="https://ark.cn-beijing.volces.com/api/v3"

# ============================================
# Qwen/DashScope API 配置（仅用于 Embedding）
# ============================================
# Qwen API Key（用于 text-embedding-v4）
QWEN_API_KEY="your_qwen_api_key_here"
